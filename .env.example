# Server-only secrets. Never commit .env or put these in public/config.js.
OPENAI_API_KEY=
# GPT-4.1 mini snapshot is fixed in server/openai.js to match the cost calculation.
# Service-wide GPT cap for all members, then the sub-pool that free members' AI taster may use.
# Keep AI_GLOBAL_MONTHLY_USD > AI_FREE_GLOBAL_MONTHLY_USD so paying members always keep headroom.
AI_GLOBAL_MONTHLY_USD=20
AI_FREE_GLOBAL_MONTHLY_USD=5

FIREBASE_PROJECT_ID=yumetan-a31f0
FIRESTORE_DATABASE_ID=(default)
# JSON service-account credentials for the SAME project as public/firebase-config.js.
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS / workload identity.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe test credentials first; switch all keys, prices and webhook secret together for live mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
PUBLIC_APP_URL=https://yumetan.onrender.com
# Public support/contact page for community reports and billing enquiries.
SUPPORT_URL=
# RevenueCat (App Store subscriptions).
# Webhook: Integrations → Webhooks → Authorization header value. The server accepts
# POST /api/billing/revenuecat only when this header matches exactly.
REVENUECAT_WEBHOOK_AUTH=
# Grant plans for SANDBOX purchases too (TestFlight / sandbox testers). Keep false in production.
REVENUECAT_ALLOW_SANDBOX=false
# Used only by scripts/revenuecat-setup.mjs (v2 secret key with write access to
# products/entitlements/offerings) — never read by server.js.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
# iOS build only: the App Store app's public SDK key from RevenueCat → Apps. Embedded into
# dist/config.js by `npm run mobile:build`; it is a public key, not a secret.
REVENUECAT_APPLE_API_KEY=
# PORT=3000
