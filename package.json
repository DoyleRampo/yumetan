{
  "name": "yumetan",
  "version": "4.4.0",
  "description": "ユメタン — 16タイプの夢キャラクターを育てる、夢と睡眠の日記AI（日本語・English・한국어・中文）",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:assets": "npx capacitor-assets generate --iconBackgroundColor \"#0f1222\" --iconBackgroundColorDark \"#0f1222\" --splashBackgroundColor \"#0f1222\" --splashBackgroundColorDark \"#0f1222\"",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check public/app.js && node --check server.js && node --check server-features.js",
    "test:browser": "playwright test",
    "characters:build": "node scripts/build-characters.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^13.6.0",
    "express": "^4.21.0",
    "firebase-admin": "^14.4.0",
    "openai": "^7.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "sharp": "0.32.6"
  }
}
