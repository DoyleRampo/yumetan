# Claude API キー（https://console.anthropic.com/ で発行）必須
ANTHROPIC_API_KEY=sk-ant-...

# 使用モデル（省略時: claude-opus-5。安くするなら claude-sonnet-5）
CLAUDE_MODEL=claude-sonnet-5

# 公開時の利用制限（1端末/日、全体/日 の AI 呼び出し回数）
LIMIT_PER_USER_DAY=60
LIMIT_GLOBAL_DAY=3000

# 合言葉（設定すると、知っている人だけ使える。空なら誰でも）
ACCESS_CODE=

# ポート（省略時: 3000）
# PORT=3000
