# Server-only secrets. Never commit .env or put these in public/config.js.
OPENAI_API_KEY=
# GPT-5.6 Luna snapshot is fixed in server/openai.js to match the cost calculation.
AI_GLOBAL_MONTHLY_USD=20

FIREBASE_PROJECT_ID=yumetan-a31f0
FIRESTORE_DATABASE_ID=(default)
# JSON service-account credentials for the SAME project as public/firebase-config.js.
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS / workload identity.
FIREBASE_SERVICE_ACCOUNT_JSON=

# RevenueCat (App Store / Google Play subscriptions). Both are server-only secrets.
# Secret API key (sk_...): RevenueCat → Project settings → API keys → Secret API keys.
REVENUECAT_SECRET_API_KEY=
# Any long random string; paste the same value as the webhook's Authorization header
# in RevenueCat → Integrations → Webhooks (URL: https://<server>/api/billing/revenuecat).
REVENUECAT_WEBHOOK_AUTH=
# Public SDK keys (appl_/goog_) are NOT set here; pass them to scripts/build-mobile.mjs.
# Public support/contact page for community reports and billing enquiries.
SUPPORT_URL=
# PORT=3000
