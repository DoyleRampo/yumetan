# Server-only secrets. Never commit .env or put these in public/config.js.
OPENAI_API_KEY=
# GPT-4.1 mini snapshot is fixed in server/openai.js to match the cost calculation.
AI_GLOBAL_MONTHLY_USD=20

FIREBASE_PROJECT_ID=yumetan-a31f0
FIRESTORE_DATABASE_ID=(default)
# JSON service-account credentials for the SAME project as public/firebase-config.js.
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS / workload identity.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe test credentials first; switch all keys, prices and webhook secret together for live mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
PUBLIC_APP_URL=https://yumetan.onrender.com

# RevenueCat (iOS / Android in-app subscriptions). The secret key (sk_...) stays on the server.
REVENUECAT_SECRET_API_KEY=
# Exact Authorization header value set on the RevenueCat webhook (POST /api/billing/revenuecat/webhook).
REVENUECAT_WEBHOOK_AUTH=
# Sandbox / Test Store purchases grant plans while true. Set false on the production server.
REVENUECAT_ACCEPT_SANDBOX=true
# Mobile build only: public SDK keys embedded into dist/config.js by scripts/build-mobile.mjs.
# Leave empty to use the RevenueCat Test Store key while testing.
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
# Public support/contact page for community reports and billing enquiries.
SUPPORT_URL=
# PORT=3000
